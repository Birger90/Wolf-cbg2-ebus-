     }
    ],
    "sequence": [
     {
      "action": "mqtt.publish",
      "data": {
       "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/get",
       "payload": ""
      }
     },
     {
      "delay": {
       "seconds": 4
      }
     },
     {
      "variables": {
       "orig": "{{ states(repeat.item.entity) | float(none) }}"
      }
     },
     {
      "if": [
       {
        "condition": "template",
        "value_template": "{{ orig is none }}"
       }
      ],
      "then": [
       {
        "action": "logbook.log",
        "data": {
         "name": "Heizung Parametertest",
         "message": "{{ repeat.item.circuit }}/{{ repeat.item.name }}: UEBERSPRUNGEN, kein Lesewert"
        }
       }
      ],
      "else": [
       {
        "variables": {
         "ziel": "{{ orig + 1 }}"
        }
       },
       {
        "if": [
         {
          "condition": "template",
          "value_template": "{{ repeat.item.circuit in ['hc', 'mm'] }}"
         }
        ],
        "then": [
         {
          "action": "script.heizung_therme_schreiben",
          "continue_on_error": true,
          "data": {
           "kreis": "{{ repeat.item.circuit }}",
           "name": "{{ repeat.item.name }}",
           "tn": "{{ repeat.item.tn }}",
           "wert": "{{ ziel }}",
           "teiler": "{{ repeat.item.teiler }}"
          }
         }
        ],
        "else": [
         {
          "action": "mqtt.publish",
          "data": {
           "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/set",
           "payload": "{{ ziel }}"
          }
         },
         {
          "delay": {
           "seconds": 3
          }
         },
         {
          "action": "mqtt.publish",
          "data": {
           "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/get",
           "payload": ""
          }
         },
         {
          "delay": {
           "seconds": 4
          }
         }
        ]
       },
       {
        "variables": {
         "nach_test": "{{ states(repeat.item.entity) | float(none) }}"
        }
       },
       {
        "variables": {
         "ziel": "{{ orig }}"
        }
       },
       {
        "if": [
         {
          "condition": "template",
          "value_template": "{{ repeat.item.circuit in ['hc', 'mm'] }}"
         }
        ],
        "then": [
         {
          "action": "script.heizung_therme_schreiben",
          "continue_on_error": true,
          "data": {
           "kreis": "{{ repeat.item.circuit }}",
           "name": "{{ repeat.item.name }}",
           "tn": "{{ repeat.item.tn }}",
           "wert": "{{ ziel }}",
           "teiler": "{{ repeat.item.teiler }}"
          }
         }
        ],
        "else": [
         {
          "action": "mqtt.publish",
          "data": {
           "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/set",
           "payload": "{{ ziel }}"
          }
         },
         {
          "delay": {
           "seconds": 3
          }
         },
         {
          "action": "mqtt.publish",
          "data": {
           "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/get",
           "payload": ""
          }
         },
         {
          "delay": {
           "seconds": 4
          }
         }
        ]
       },
       {
        "if": [
         {
          "condition": "template",
          "value_template": "{{ (states(repeat.item.entity) | float(-9999) - orig) | abs > 0.05 }}"
         }
        ],
        "then": [
         {
          "variables": {
           "ziel": "{{ orig }}"
          }
         },
         {
          "if": [
           {
            "condition": "template",
            "value_template": "{{ repeat.item.circuit in ['hc', 'mm'] }}"
           }
          ],
          "then": [
           {
            "action": "script.heizung_therme_schreiben",
            "continue_on_error": true,
            "data": {
             "kreis": "{{ repeat.item.circuit }}",
             "name": "{{ repeat.item.name }}",
             "tn": "{{ repeat.item.tn }}",
             "wert": "{{ ziel }}",
             "teiler": "{{ repeat.item.teiler }}"
            }
           }
          ],
          "else": [
           {
            "action": "mqtt.publish",
            "data": {
             "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/set",
             "payload": "{{ ziel }}"
            }
           },
           {
            "delay": {
             "seconds": 3
            }
           },
           {
            "action": "mqtt.publish",
            "data": {
             "topic": "ebusd/{{ repeat.item.circuit }}/{{ repeat.item.name }}/get",
             "payload": ""
            }
           },
           {
            "delay": {
             "seconds": 4
            }
           }
          ]
         }
        ]
       },
       {
        "action": "logbook.log",
        "data": {
         "name": "Heizung Parametertest",
         "message": "{{ repeat.item.circuit }}/{{ repeat.item.name }}: orig {{ orig }} -> +1 gelesen {{ nach_test }} -> zurueck gelesen {{ states(repeat.item.entity) }} | {{ 'SCHREIBEN OK' if nach_test is not none and (nach_test - orig - 1) | abs < 0.05 else 'SCHREIBEN FEHLGESCHLAGEN' }}, {{ 'RUECKSETZEN OK' if (states(repeat.item.entity) | float(-9999) - orig) | abs < 0.05 else 'RUECKSETZEN FEHLGESCHLAGEN' }}"
        }
       },
       {
        "if": [
         {
          "condition": "template",
          "value_template": "{{ (states(repeat.item.entity) | float(-9999) - orig) | abs > 0.05 }}"
         }
        ],
        "then": [
         {
          "action": "notify.mobile_app_birger_iphone",
          "data": {
           "title": "Heizung Parametertest: Ruecksetzen fehlgeschlagen",
           "message": "{{ repeat.item.circuit }}/{{ repeat.item.name }} sollte {{ orig }} sein, gelesen {{ states(repeat.item.entity) }}"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "action": "logbook.log",
   "data": {
    "name": "Heizung Parametertest",
    "message": "Ende"
   }
  },
  {
   "action": "notify.mobile_app_birger_iphone",
   "data": {
    "title": "Heizung Parametertest beendet",
    "message": "Ergebnis im Logbuch unter 'Heizung Parametertest'."
   }
  }
 ]
}